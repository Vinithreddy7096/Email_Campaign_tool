# Copy to .env and fill in. NEVER commit .env.
# Values left empty here are REQUIRED and have no safe default — the app fails
# loudly at boot in staging/production rather than guessing. See docs/OPEN_QUESTIONS.md.

# ─── Core ────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=https://app.example.internal

# ─── Safety ──────────────────────────────────────────────────────────────
# MOCK_MODE=true routes ALL outbound SMTP to the local sink. Never true in prod.
MOCK_MODE=true
# Hard global kill switch. When true, no worker may hand off to an MTA.
GLOBAL_SEND_ENABLED=false
# Comma-separated. In non-prod, refuse to send to any domain not on this list.
ALLOWED_TEST_RECIPIENT_DOMAINS=example.test,mailhog.local

# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://mailer:mailer@postgres:5432/mailer
DB_CONN_MAX_AGE=60
DB_STATEMENT_TIMEOUT_MS=30000

# ─── Broker / cache ──────────────────────────────────────────────────────
RABBITMQ_URL=amqp://mailer:mailer@rabbitmq:5672//
REDIS_URL=redis://redis:6379/0

# ─── MTA handoff ─────────────────────────────────────────────────────────
# Workers submit here. In MOCK_MODE this points at MailHog.
MTA_SMTP_HOST=mailhog
MTA_SMTP_PORT=1025
MTA_SMTP_USE_TLS=false
MTA_SMTP_USERNAME=
MTA_SMTP_PASSWORD=
MTA_SUBMISSION_TIMEOUT_S=30
MTA_MAX_CONNECTIONS=20

# ─── Identity / DNS ──────────────────────────────────────────────────────
DEFAULT_RETURN_PATH_DOMAIN=bounce.example.com
DEFAULT_TRACKING_DOMAIN=links.example.com
MESSAGE_ID_DOMAIN=mail.example.com
DKIM_SELECTOR_DEFAULT=s1
# Private keys NEVER live in the repo. Ansible delivers them from Vault.
DKIM_KEY_DIR=/etc/opendkim/keys

# ─── Rate governance (defaults; per-provider overrides live in DB) ────────
GLOBAL_MAX_MSGS_PER_MINUTE=200
DEFAULT_PROVIDER_MAX_CONCURRENCY=5
DEFAULT_PROVIDER_MAX_PER_HOUR=2000
CAMPAIGN_EXPANSION_BATCH_SIZE=500

# ─── Retry policy ────────────────────────────────────────────────────────
RETRY_BACKOFF_SECONDS=300,900,3600,10800,21600,43200
MAX_DELIVERY_ATTEMPTS=6
MESSAGE_MAX_AGE_HOURS=72

# ─── Suppression ─────────────────────────────────────────────────────────
SOFT_BOUNCE_SUPPRESS_THRESHOLD=5
SOFT_BOUNCE_WINDOW_DAYS=30
# 0.1%
COMPLAINT_RATE_ALERT_THRESHOLD=0.001
# 2%
HARD_BOUNCE_RATE_ALERT_THRESHOLD=0.02

# ─── Consent ─────────────────────────────────────────────────────────────
# Referenced by BUILD.md §8.3 ("If CONSENT_MAX_AGE_DAYS is configured") but
# absent from the §4.1 listing. Empty = no age ceiling on marketing consent.
CONSENT_MAX_AGE_DAYS=

# ─── Tracking (privacy defaults: OFF) ────────────────────────────────────
TRACKING_OPENS_ENABLED=false
TRACKING_CLICKS_ENABLED=false
TRACKING_RETENTION_DAYS=90

# ─── Storage ─────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=mailer-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ─── Observability ───────────────────────────────────────────────────────
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# ─── Security ────────────────────────────────────────────────────────────
MFA_REQUIRED_ROLES=SYSTEM_ADMIN,APPROVER
API_TOKEN_DEFAULT_TTL_DAYS=90
WEBHOOK_SIGNING_SECRET=
SESSION_COOKIE_AGE=28800
ABUSE_CONTACT_EMAIL=abuse@example.com
