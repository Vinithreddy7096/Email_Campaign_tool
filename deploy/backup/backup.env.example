# Copy to /etc/email-platform/backup.env (root:root, mode 0600). Never commit
# the real file. Values below are placeholders.

# The production database (read access is enough for pg_dump).
DATABASE_URL=postgres://backup_reader:CHANGE_ME@db1.internal:5432/mailer
# A separate server where the weekly restore test may create a scratch database.
RESTORE_DATABASE_URL=postgres://restore_check:CHANGE_ME@db-restore.internal:5432/postgres

BACKUP_ENV=production
BACKUP_S3_BUCKET=example-mailer-backups
# BACKUP_S3_PREFIX=postgres/production
# S3_ENDPOINT_URL=https://minio.internal:9000      # MinIO only
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=eu-west-1
# Encrypt at rest. aws:kms with a key the backup role can only encrypt with is
# better still; enable bucket versioning + object lock so a compromised host
# cannot delete history.
BACKUP_SSE=AES256
# BACKUP_KMS_KEY_ID=arn:aws:kms:...

BACKUP_RETENTION_DAYS=14
BACKUP_KEEP_MONTHLY=12
