# ─── One transport per stream (§10.1, §10.3) ─────────────────────────────
# Each binds its pool's IP and uses a HELO name matching that IP's PTR, and
# logs as postfix-<stream>/smtp so the two streams are told apart.
{% for stream in postfix_streams %}
{{ stream.name }} unix  -       -       y       -       -       smtp
        -o syslog_name=postfix-{{ stream.name }}
{% if stream.bind_address | default("") %}
        -o smtp_bind_address={{ stream.bind_address }}
{% endif %}
{% if stream.bind_address6 | default("") %}
        -o smtp_bind_address6={{ stream.bind_address6 }}
{% endif %}
        -o smtp_helo_name={{ stream.helo_name | default(postfix_hostname) }}
{% endfor %}

# ─── Bounce / FBL intake (§10.8.1) ───────────────────────────────────────
# O = X-Original-To, D = Delivered-To, R = Return-Path: the app finds the VERP
# address there. forward-bounce exits 75 (EX_TEMPFAIL) if the app cannot take
# the message, so Postfix keeps it and retries — nothing is lost.
# pipe(8) runs with exactly this uid:gid (no supplementary groups), so the
# group is the one that may read the intake secret.
bounces   unix  -       n       n       -       {{ postfix_bounce_pipe_maxproc }}       pipe
        flags=ODRq user={{ forwarder_user }}:mtaintake argv=/usr/local/bin/forward-bounce
